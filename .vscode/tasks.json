{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/Program.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "docker-compose-dev",
      "type": "shell",
      "command": "docker compose -f docker-compose.dev.yml up api --build",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
